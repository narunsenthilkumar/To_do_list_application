{
  "expo": {
    "name": "Taskora",
    "slug": "taskora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taskora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskora.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Taskora uses speech recognition to create tasks from voice.",
        "NSMicrophoneUsageDescription": "Taskora uses your microphone to transcribe voice tasks."
      }
    },
    "android": {
      "package": "com.taskora.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#38BDF8"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Taskora uses your microphone to transcribe and create tasks from your voice.",
          "speechRecognitionPermission": "Taskora uses on-device speech recognition to transcribe your tasks."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b84537e-894c-498b-a733-f588ab53295b"
      }
    }
  }
}
